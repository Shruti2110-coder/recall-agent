# Copy this file to .env.local and fill in your keys. Never commit .env.local.
# You need at least ONE model key (Groq or Google). If both are set, Groq is tried first and Google is the backup.

# Groq API key, from https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini API key, from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Tavily web search key (REQUIRED), from https://app.tavily.com
TAVILY_API_KEY=

# Optional: which Groq model to use (default: openai/gpt-oss-120b)
# GROQ_MODEL_ID=openai/gpt-oss-120b

# Optional: which Gemini model to use (default: gemini-3.5-flash-lite)
# MODEL_ID=gemini-3.5-flash-lite
